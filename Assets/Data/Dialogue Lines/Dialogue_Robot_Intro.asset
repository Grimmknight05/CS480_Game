  m_Script: {fileID: 11500000, guid: 7e77206a52ab94f2ba951b2670e9efed, type: 3}
  m_Name: Dialogue_Robot_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  lines:
  - speaker: {fileID: 11400000, guid: c4760c532a38645deb38bba307f31e9c, type: 2}
    text: 'Diagnostics complete. Motor functions optimal. Assessing terrain damage...

      (Press
      E to continue)'
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: c4760c532a38645deb38bba307f31e9c, type: 2}
    text: "Are you a\u2026 human? I haven\u2019t seen one on this world in a very
      long time.\n"
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: c4760c532a38645deb38bba307f31e9c, type: 2}
    text: Use [W][A][S][D] to navigate the ruins.
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: c4760c532a38645deb38bba307f31e9c, type: 2}
    text: Press [SPACE] to jump and [E] to interact with terminals like me.
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: c4760c532a38645deb38bba307f31e9c, type: 2}
    text: Good Luck out there, astronout.
    autoAdvanceDelay: 0
  playOnce: 0
  retriggerCooldown: 5
