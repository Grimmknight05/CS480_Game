  lines:
  - speaker: {fileID: 11400000, guid: 8f3054a250bbc456aa8d964731c50544, type: 2}
    text: Can't you see I'm busy reading?!
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: 8f3054a250bbc456aa8d964731c50544, type: 2}
    text: ...
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: 8f3054a250bbc456aa8d964731c50544, type: 2}
    text: It's about the stone robots that glow red and watch over us.
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: 8f3054a250bbc456aa8d964731c50544, type: 2}
    text: There's something wrong around here, but Mom and Dad don't believe me...
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: 8f3054a250bbc456aa8d964731c50544, type: 2}
    text: Do you believe me?
    autoAdvanceDelay: 0
  playOnce: 1
  retriggerCooldown: 5
