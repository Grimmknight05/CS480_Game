  lines:
  - speaker: {fileID: 11400000, guid: bc655e9f7f15e4036b46b72f127461e2, type: 2}
    text: I don't know how you did it but thank you.
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: bc655e9f7f15e4036b46b72f127461e2, type: 2}
    text: You've successfully dropped all those pesky defenses they had up.
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: bc655e9f7f15e4036b46b72f127461e2, type: 2}
    text: Our leader stirs. The signals activated here will aid him on Magmora.
    autoAdvanceDelay: 0
