  - speaker: {fileID: 11400000, guid: bc655e9f7f15e4036b46b72f127461e2, type: 2}
    text: "You really walked right in. You shouldn\u2019t be so trusting."
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: bc655e9f7f15e4036b46b72f127461e2, type: 2}
    text: The cave has closed. And you are exactly where we wanted you.
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: bc655e9f7f15e4036b46b72f127461e2, type: 2}
    text: Good luck getting out of here...
    autoAdvanceDelay: 0
