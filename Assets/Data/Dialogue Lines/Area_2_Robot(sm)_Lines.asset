  lines:
  - speaker: {fileID: 0}
    text: Those little ones love their mushrooms.
    autoAdvanceDelay: 0
  - speaker: {fileID: 0}
    text: Bounce on the mushrooms to activate their glow.
    autoAdvanceDelay: 0
  - speaker: {fileID: 0}
    text: The little ones can't resist taking a nap underneath their warm glow.
    autoAdvanceDelay: 0
  - speaker: {fileID: 0}
    text: Each color of mushroom makes a different sound too. Have some fun with
      them.
    autoAdvanceDelay: 0
  playOnce: 0
  retriggerCooldown: 0
