  lines:
  - speaker: {fileID: 11400000, guid: a860fa40fee7e4c3abe85960a6250e56, type: 2}
    text: 'We know not what we do. '
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: a860fa40fee7e4c3abe85960a6250e56, type: 2}
    text: 'The haze of the red light blinds us.. '
    autoAdvanceDelay: 0
  - speaker: {fileID: 11400000, guid: a860fa40fee7e4c3abe85960a6250e56, type: 2}
    text: 'Yet, you must not continue forward. It is not safe. '
    autoAdvanceDelay: 0
